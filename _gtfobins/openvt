---
functions:
  command:
  - blind: true
    code: |-
      openvt -- /path/to/command
    comment: |-
      The command execution is displayed on the virtual console.
    contexts:
      sudo:
  shell:
  - code: |-
      sudo openvt -s /bin/sh
    comment: |-
      Opens a shell on a new virtual console.
    contexts:
      sudo:
...
